# =====================================================================
# SIPENGUJI — Konfigurasi Environment Variables
# =====================================================================
# Variabel di bawah memiliki default aman untuk lingkungan STAGING.
# Variabel rahasia staging dibuat & disimpan secara aman di sisi server
# apabila tidak disetel secara manual.
#
# Untuk DEPLOYMENT PRODUKSI (hanya setelah disetujui Admin), gunakan
# template .env.production.example dan wajib isi variabel rahasia kuat.
# =====================================================================

SIPENGUJI_ENV="staging"
SIPENGUJI_DB_PATH="./data/sipenguji.db"
SIPENGUJI_PRIVATE_STORAGE="./storage/private"
SIPENGUJI_MAX_UPLOAD_MB="10"

# --- Variabel Rahasia & Opsional (Wajib diisi khusus pada Produksi) ---
# SIPENGUJI_SESSION_SECRET=""
# SIPENGUJI_ADMIN_DEFAULT_PASSWORD=""
# SIPENGUJI_REG_CODE=""
# SIPENGUJI_SAUM_STAGING_DATA_PATH="staging/saum-staging-sample.readonly.json"
# SIPENGUJI_STAGING_TEST_PASSWORD=""
